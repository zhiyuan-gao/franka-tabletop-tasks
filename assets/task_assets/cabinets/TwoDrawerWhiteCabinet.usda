    def Scope "Looks"
    {
        def Material "WhiteMelamine"
        {
            token outputs:surface.connect = </TwoDrawerWhiteCabinet/Looks/WhiteMelamine/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.94, 0.94)
                float inputs:metallic = 0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Aluminum"
        {
            token outputs:surface.connect = </TwoDrawerWhiteCabinet/Looks/Aluminum/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:metallic = 0.82
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "BlackDrawerRail"
        {
            token outputs:surface.connect = </TwoDrawerWhiteCabinet/Looks/BlackDrawerRail/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.025, 0.025)
                float inputs:metallic = 0
                float inputs:roughness = 0.33
                token outputs:surface
            }
        }
    }

