#usda 1.0
(
    defaultPrim = "Banana"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Banana" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    prepend references = @./011_banana.usd@</Root>
)
{
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.066
    bool physics:rigidBodyEnabled = 1
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 2

    over "_11_banana" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        uniform token physics:approximation = "convexDecomposition"
        rel physics:material:binding = </Banana/PhysicsMaterial>
        float physxCollision:contactOffset = 0.003
        float physxCollision:restOffset = 0
        float physxConvexDecompositionCollision:errorPercentage = 10
        int physxConvexDecompositionCollision:hullVertexLimit = 48
        int physxConvexDecompositionCollision:maxConvexHulls = 8
        bool physxConvexDecompositionCollision:shrinkWrap = 1
        int physxConvexDecompositionCollision:voxelResolution = 50000
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0
        float physics:staticFriction = 0.8
    }
}
