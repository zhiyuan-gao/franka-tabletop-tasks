#usda 1.0
(
    defaultPrim = "SingleDoorWhiteCabinet"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SingleDoorWhiteCabinet" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    kind = "component"
)
{
    custom double cabinet:depth = 0.34
    custom string cabinet:designFamily = "ML-Design ML-093 approximation"
    custom double cabinet:doorHeight = 0.264
    custom double cabinet:doorWidth = 0.345
    custom string cabinet:frontAxis = "+Y"
    custom double cabinet:handleWidth = 0.11
    custom double cabinet:height = 0.37
    custom string cabinet:hingeSide = "left"
    custom double cabinet:width = 0.38

    def Scope "Looks"
    {
        def Material "WhiteMelamine"
        {
            token outputs:surface.connect = </SingleDoorWhiteCabinet/Looks/WhiteMelamine/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.94, 0.94)
                float inputs:metallic = 0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Aluminum"
        {
            token outputs:surface.connect = </SingleDoorWhiteCabinet/Looks/Aluminum/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:metallic = 0.82
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }
    }

    def Scope "PhysicsMaterials"
    {
        def Material "CabinetSurface" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.38
            float physics:restitution = 0.02
            float physics:staticFriction = 0.45
        }

        def Material "HandleSurface" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }

